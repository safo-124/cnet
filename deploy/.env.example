# Copy to .env in the repository root on the server and fill in.

# The address visitors use. With no domain of your own, use your server's IPv4 address
# with dashes and .sslip.io, e.g. 203.0.113.10 -> 203-0-113-10.sslip.io (free, and HTTPS works).
# Only used by the bundled Caddy (--profile proxy).
DOMAIN=203-0-113-10.sslip.io

# Port on 127.0.0.1 where the app listens for a reverse proxy. Change it if 8080 is already taken.
APP_PORT=8080
